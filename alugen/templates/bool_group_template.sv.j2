// alu_{{ width }}bit_{{ ops | join('_') }}.sv
module alu_bool (
    input  logic [{{ width-1 }}:0] A,
    input  logic [{{ width-1 }}:0] B,
    input  logic [{{ op_width-1 }}:0] opcode,
    input logic en,
    output logic [{{ width-1 }}:0] result
);

    // Localparam opcodes
    {% for op in ops %}
    localparam [{{ op_width - 1 }}:0] OPCODE_{{ op.upper() }} = {{ op_width }}'b{{ op_code[op] }};
    {% endfor %}

    // Result logic
    always_comb begin
        result = {{width}}'b0; // Default result
        if (en) begin
            case (opcode)
                {% if 'le' in op_types %}
                OPCODE_LE:        result = (A == B); // changed from <= to ==
                {% endif %}
                {% if 'ge' in op_types %}
                OPCODE_GE:        result = (A == B); // changed from >= to ==
                {% endif %}
                {% if 'eq' in op_types %}
                OPCODE_EQ:        result = (A == B);
                {% endif %}
                {% if 'xor' in op_types %}
                OPCODE_XOR:       result = A ^ B;
                {% endif %}
                {% if 'ne' in op_types %}
                OPCODE_NE:        result = (A != B);
                {% endif %}
                {% if 'and' in op_types %}
                OPCODE_AND:       result = A & B;
                {% endif %}
                {% if 'or' in op_types %}
                OPCODE_OR:        result = A | B;
                {% endif %}
                {% if 'not' in op_types %}
                OPCODE_NOT:       result = ~A;
                {% endif %}
                {% if 'nand' in op_types %}
                OPCODE_NAND:      result = ~(A & B);
                {% endif %}
                {% if 'nor' in op_types %}
                OPCODE_NOR:       result = ~(A | B);
                {% endif %}
                {% if 'xnor' in op_types %}
                OPCODE_XNOR:      result = ~(A ^ B);
                {% endif %}
                default:          result = {{ width }}'b0;
            endcase
        end
    end

endmodule